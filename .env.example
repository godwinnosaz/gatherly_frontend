# Gatherly frontend environment variables example
# Copy this file to `.env.local` or `.env.development` and set values as needed.

# Full base URL for API (production/staging). When set, this overrides other fallbacks.
VITE_API_BASE_URL=

# Alternative: if you prefer using host/port/path instead of a full URL
# VITE_API_PORT=5000
# VITE_API_PATH=/api
# VITE_LOCAL_IP=192.168.1.10

# Optional mode override (development|production)
# VITE_API_MODE=development

# Note: Do NOT commit secrets or credentials to source control.